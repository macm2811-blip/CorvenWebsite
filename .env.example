# Public values. Add them to Vercel for Preview and Production.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server only. Never prefix this key with NEXT_PUBLIC_.
# Supabase calls this the secret key (legacy projects may use service_role).
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Public application URL used in invitation and password-reset links.
NEXT_PUBLIC_SITE_URL=https://corvenwebsite.vercel.app

# One-time onboarding script (local only).
LMS_OWNER_EMAIL=owner@example.com
LMS_OWNER_NAME=CORVEN Owner
LEVEL_UP_ADMIN_EMAIL=admin@example.com
LEVEL_UP_ADMIN_NAME=Level Up Administrator
